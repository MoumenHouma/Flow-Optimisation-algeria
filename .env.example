# ─── RouteOpt environment (see docs/RULES.md §4.3) ───────────────────────────
# Copy to .env and adjust. Never commit .env.

# General
DEBUG=true
LOG_LEVEL=DEBUG
ENVIRONMENT=local

# Database (PostgreSQL + PostGIS)
DB_URL=postgresql+asyncpg://routeopt:routeopt@localhost:5432/routeopt
POSTGRES_USER=routeopt
POSTGRES_PASSWORD=routeopt
POSTGRES_DB=routeopt

# Redis (cache / queue / session)
REDIS_URL=redis://localhost:6379/0

# OSRM routing engine
OSRM_URL=http://localhost:5000

# Geocoding (Nominatim) — F2. Self-host for production; the public instance
# caps at ~1 req/s (set NOMINATIM_RATE_LIMIT_S=0 when self-hosted).
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RouteOpt/1.0 (+https://routeopt.dz)
NOMINATIM_COUNTRY=dz
NOMINATIM_RATE_LIMIT_S=1.0

# Object storage (MinIO / S3) — proofs of delivery, exports
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=routeopt

# Auth (JWT RS256 — see docs/ARCHITECTURE.md §5.1)
# In prod, load JWT_PRIVATE_KEY / JWT_PUBLIC_KEY from a vault.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optimization worker
OPTIMIZE_TIME_LIMIT_SECONDS=30
OPTIMIZE_QUEUE=queue:optimize

# Observability (optional in local)
SENTRY_DSN=

# Frontend (Vite — prefix VITE_ to expose to the client)
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=/map-style.json
