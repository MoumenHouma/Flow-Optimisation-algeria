# ─── RouteOpt production environment (docs/DEPLOYMENT.md) ────────────────────
# Copy to .env on the host and fill in real values. NEVER commit the real .env.
# Load actual secrets from your secrets manager; the placeholders below only
# document the shape. The app refuses to boot with insecure defaults when
# ENVIRONMENT != local (config.py::_guard_production).

# General
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Data layer — point at managed services (not the local compose containers).
DB_URL=postgresql+asyncpg://<user>:<password>@<pg-host>:5432/routeopt
REDIS_URL=redis://<redis-host>:6379/0

# OSRM routing engine (self-hosted, see infra/osrm/prepare.sh).
OSRM_URL=http://osrm:5000
OSRM_FILE=algeria-latest.osrm

# Geocoding — self-host Nominatim in prod and lift the public-instance rate cap.
NOMINATIM_URL=https://nominatim.<votre-hote>
NOMINATIM_USER_AGENT=RouteOpt/1.0 (+https://routeopt.dz)
NOMINATIM_COUNTRY=dz
NOMINATIM_RATE_LIMIT_S=0

# Object storage (managed S3 or self-hosted MinIO). MUST NOT be minioadmin.
S3_ENDPOINT=https://s3.<region>.amazonaws.com
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_BUCKET=routeopt-prod

# Auth (JWT RS256). Keys mounted as Docker secrets → /run/secrets/*.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Symmetric key deriving at-rest encryption (webhook secrets). 32+ random bytes:
#   openssl rand -hex 32
SECRET_KEY=<change-me>

# Optimization worker
OPTIMIZE_TIME_LIMIT_SECONDS=30
OPTIMIZE_QUEUE=queue:optimize

# CORS — the browser origin(s) allowed to call the API. No localhost in prod.
ALLOWED_ORIGINS=["https://app.routeopt.dz"]

# Observability
SENTRY_DSN=

# Frontend (baked at build time). Point at the public API origin.
VITE_API_BASE_URL=https://app.routeopt.dz
VITE_MAP_STYLE_URL=/map-style.json
